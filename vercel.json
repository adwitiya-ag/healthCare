{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["frontend/dist/**"]
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/backend/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/backend/index.js"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}